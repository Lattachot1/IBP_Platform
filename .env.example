# Docker Compose settings. Copy to .env and change the passwords:
#   cp .env.example .env
# .env is gitignored - never commit real passwords.
#
# Passwords: letters and digits only, 12+ characters with upper case,
# lower case and digits (SQL Server policy). They end up inside a
# connection string and a T-SQL literal, so avoid symbols like ' @ ? & / #.

# SQL Server administrator - used only by the mssql and db-init services
MSSQL_SA_PASSWORD=ChangeMeSaPassword1

# Least-privilege login the backend uses (read/write IBP_DB only)
IBP_APP_PASSWORD=ChangeMeAppPassword1

# Host port of the backend API
BACKEND_PORT=8080

# URL the browser uses to reach the backend. It is baked into the frontend
# at build time: use the server's address when other machines open the
# dashboard, and rebuild (docker compose up --build) after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8080
